# ===========================================================
# GLOBAL .gitignore file for Multi-Language AI Sandboxes
# (Goland, PyCharm, RustRover, CLion, VS Code)
# Place in the root directory of your project as '.gitignore'
# Do NOT deploy a .gitignore file in the ./.idea directory
# of your project.
# ===========================================================

# ==========================================
# 1. GLOBAL JETBRAINS IDE POLICY (Monorepo Safe)
# ==========================================
# User-specific work states & configurations
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/**/usage.statistics.xml
**/.idea/**/dictionaries
**/.idea/**/shelf
**/.idea/**/aws.xml
**/.idea/**/contentModel.xml

# Sensitive or high-churn data sources
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml
**/.idea/**/uiDesigner.xml
**/.idea/**/dbnavigator.xml

# Build Tools & Framework Caches
**/.idea/**/gradle.xml
**/.idea/**/libraries
**/.idea/**/mongoSettings.xml
**/.idea/replstate.xml
**/.idea/sonarlint/
**/.idea/sonarlint.xml
**/.idea/caches/build_file_checksums.ser
**/.idea/.cache/.Apifox_Helper
**/.idea/ApifoxUploaderProjectSetting.xml
**/.idea/**/copilot.data.migration.*.xml
*.iws
out/
cmake-build-*/

# Editor-based HTTP Client
**/.idea/httpRequests
**/http-client.private.env.json

# ==========================================
# 2. GOLANG POLICY
# ==========================================
# Compiled Object files, Static and Dynamic libs
*.com
*.class
*.dll
*.exe
*.o
*.suo
*.so
*.dylib
*.test
*.out
*.a
bin/
_obj/
obj/
.benchcheck/

# Go specific entries
*.cgo1.go
*.cgo2.c
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*
*.prof

# ==========================================
# 3. PYTHON & RUST POLICY (AI Agent Extensions)
# ==========================================
# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv
venv/
ENV/

# Rust Build Artifacts
target/

# ==========================================
# 4. MISCELLANEOUS, OS, & SECURITY
# ==========================================
*.gpState
*.user
*.pem
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db